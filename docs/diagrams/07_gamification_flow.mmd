flowchart LR
    Viewer["MaterialViewer"]
    Progress["PUT /reads/:id/progress"]
    Toggle["POST /reads/:id/toggle"]
    Heartbeat["POST /api/streaks/heartbeat"]

    Backlog[("reading_backlog")]
    Reads[("material_reads")]
    Streak[("reading_streaks")]
    XP[("users.xp / rank_level")]
    Sessions[("in-memory<br/>readingSessions")]
    Badges[("user_badges")]
    Notif[("notifications")]

    Viewer --> Progress
    Viewer --> Toggle
    Viewer --> Heartbeat

    Progress -->|"client page/total"| Backlog
    Progress -->|"completed"| Reads
    Progress -->|"first completion"| XP
    Progress --> Badges
    Progress --> Notif

    Toggle -->|"mark read"| Reads
    Toggle -->|"award 100 XP"| XP
    Toggle -->|"unmark"| Reads
    Toggle -.->|"XP not reversed"| XP

    Heartbeat -->|"trusted activeSeconds"| Sessions
    Heartbeat -->|"register activity"| Streak
    Heartbeat --> Notif

