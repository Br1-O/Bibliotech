# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos MariaDB / MySQL ---
DB_HOST=localhost
DB_USER=bibliotech
DB_PASS=bibliotech
DB_NAME=bibliotech
# DB_PORT=3306
# Activar solo si el servidor exige TLS (por ejemplo Aiven).
# DB_SSL=true

# --- Seguridad ---
JWT_SECRET=cambia_esta_clave_secreta_super_segura
JWT_EXPIRES=2h

# --- Recuperacion de contrasena, verificacion e internacionalizacion ---
APP_URL=http://localhost:3000
RESET_TOKEN_MINUTES=60
VERIFY_TOKEN_MINUTES=60
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en

# --- Correo transaccional (Nodemailer / Gmail) ---
# Usa una contrasena de aplicacion de Gmail, no la contrasena normal.
EMAIL_USER_1=tu_correo@gmail.com
EMAIL_PASS_1=tu_contrasena_de_aplicacion

# --- Almacenamiento (local o cloud) ---
FILES_MODE=local
