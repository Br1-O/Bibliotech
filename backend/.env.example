# --- Servidor ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Base de datos MariaDB / MySQL ---
DB_HOST=localhost
DB_USER=bibliotech
DB_PASS=bibliotech
DB_NAME=bibliotech
# DB_PORT=3306
# DB_CONNECTION_LIMIT=10
# DB_QUEUE_LIMIT=50
# DB_CONNECT_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=15000
# DB_IDLE_TIMEOUT_MS=300000
# DB_POOL_WARMUP=2
# Los placeholders se escapan en el cliente; activar solo si se prefieren
# prepared statements y la base esta en la misma red.
# DB_PREPARED_STATEMENTS=false
# Activar solo si el servidor exige TLS (por ejemplo Aiven).
# DB_SSL=true

# --- Seguridad ---
# Minimo 32 caracteres y 128 bits de entropia estimada. No uses valores por defecto.
JWT_SECRET=cambia_esta_clave_secreta_super_segura
JWT_EXPIRES=2h
JWT_ISSUER=bibliotech
JWT_AUDIENCE=bibliotech-api
# Nunca activar en produccion. Solo para pruebas automatizadas.
EXPOSE_DEV_TOKENS=false
# Lista separada por comas. Obligatoria en produccion; no se admite "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# --- Recuperacion de contrasena, verificacion e internacionalizacion ---
RESET_TOKEN_MINUTES=60
VERIFY_TOKEN_MINUTES=60
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en
LOG_LEVEL=info

# --- Rate limiting ---
AUTH_IP_RATE_LIMIT=100
AUTH_IP_RATE_WINDOW_MS=900000
AUTH_ACCOUNT_RATE_LIMIT=10
AUTH_ACCOUNT_RATE_WINDOW_MS=900000
AUTH_RECOVERY_RATE_LIMIT=20
AUTH_RECOVERY_RATE_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT=50
UPLOAD_RATE_WINDOW_MS=60000

# --- Uploads ---
UPLOAD_MAX_FILE_BYTES=104857600
UPLOAD_MAX_REQUEST_BYTES=157286400
UPLOAD_MAX_FILES=20
UPLOAD_MAX_BATCH_ITEMS=100
MAX_COVER_BYTES=5242880

# --- Metricas ---
METRICS_ENABLED=true
# Obligatorio si METRICS_ENABLED=true en produccion.
# METRICS_TOKEN=cambia_este_token_de_metricas

# --- Correo transaccional (Nodemailer / Gmail) ---
# Usa una contrasena de aplicacion de Gmail, no la contrasena normal.
EMAIL_USER_1=tu_correo@gmail.com
EMAIL_PASS_1=tu_contrasena_de_aplicacion

# --- Almacenamiento (local o cloud) ---
FILES_MODE=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
